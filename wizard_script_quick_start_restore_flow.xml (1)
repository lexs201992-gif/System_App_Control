<?xml version="1.0" encoding="UTF-8"?>
<!--
    The wizard:uris recorded here have the inconvenience of being generated by hand, but they allow
    for the full spread of launch flags (we need FLAG_ACTIVITY_NEW_TASK [0x10000000]), where the
    <intent> tag processed by Intent.parseIntent() does not.

    The wizard action added wizard:ifLifecycle="default" will only be launched during initial setup.
    It will be skipped during deferred setup. Conversely, if the action defined
    wizard:ifLifecycle="deferred", it will only be launched during deferred setup.

    adb shell am to-intent-uri -a com.android.setupwizard.WELCOME -f 0x10000000 \-\-ez firstRun true
-->
<WizardScript xmlns:wizard="http://schemas.android.com/apk/res/com.google.android.setupwizard"
    wizard:version="2">

    <!-- Check device management [REQUIRED] -->
    <WizardAction id="check_device_management" wizard:ifLifecycle="default"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.CHECK_DEVICE_MANAGEMENT;end">
        <result wizard:name="device_owner"
            wizard:resultCode="123"
            wizard:action="END_OF_SCRIPT" />
        <result wizard:action="check_play_early_update_status" />
    </WizardAction>

    <!-- Check play early update status [REQUIRED] -->
    <WizardAction id="check_play_early_update_status"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.CHECK_PLAY_EU_STATUS;end">
    </WizardAction>

    <!--
        Start eSim final hold for quick start flow [RECOMMENDED]
        When OEMs enable eSIM in flow, the esim_setup_final_hold is required to optimize transfer process before start_restore
    -->
    <WizardAction id="esim_setup_final_hold"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.ESIM_SETUP;i.setup_type=5;end"
        wizard:node="contract:com.google.android.setupwizard.contract.carrier.EsimSetupWrapperContract" />

    <!-- Start restore process [REQUIRED] -->
    <WizardAction id="start_restore"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.ACTION_START_RESTORE;end">
        <result wizard:name="demo_mode"
            wizard:resultCode="101"
            wizard:action="demo_mode_flow" />
        <result wizard:name="oem_restore"
            wizard:resultCode="102"
            wizard:action="oem_restore_after_add_account" />
        <result wizard:action="common_setup_flow" />
    </WizardAction>

    <WizardAction id="demo_mode_flow" wizard:ifLifecycle="default"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.DEMO_MODE;end">
        <!-- For Android S and above admin-integrated flow -->
        <result wizard:name="admin_integrated_flow"
            wizard:resultCode="103"
            wizard:action="END_OF_SCRIPT" />
        <result wizard:action="exit" />
    </WizardAction>

    <!-- Placeholder for OEM restore flow [CUSTOMIZABLE] -->
    <WizardAction id="oem_restore_after_add_account" />

    <!-- Common flow to set date and time, show service opt-ins, as well as terms of service [REQUIRED] -->
    <WizardAction id="common_setup_flow" wizard:flow="WithConnectionFlow"
        wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_common_flow" />

    <!-- Check if user has added an account then go to personalization flow [REQUIRED] -->
    <WizardAction id="mfm_check"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.ACCOUNT_CHECK;end">
        <result wizard:name="no_accounts_added"
            wizard:resultCode="1"
            wizard:action="select_pai" />
    </WizardAction>

    <!-- Common set of customization steps [RECOMMENDED] -->
    <WizardAction id="personalization_flow"
        wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_common_personalization_flow">
        <result wizard:action="AFTER_PERSONALIZATION" />
    </WizardAction>

    <!-- Screen to select Play Auto Installs. If the user chooses to complete setup later, the whole personalization flow is skipped except for PAI selection here [RECOMMENDED] -->
    <WizardAction id="select_pai" wizard:ifLifecycle="default"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.SELECT_PAI;end" />

    <!-- Perform additional optional steps (while waiting for restoration to complete) [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="suggested_actions" wizard:ifLifecycle="deferred"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.SUGGESTED_ACTIONS;end" />

    <WizardAction id="AFTER_PERSONALIZATION" wizard:ifLifecycle="default" />

    <!-- Finish restore process [REQUIRED] -->
    <WizardAction id="finish_restore"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.ACTION_FINISH_RESTORE;end">
        <result wizard:name="setup_work_profile"
            wizard:resultCode="101"
            wizard:action="load_work_account_intent" />
        <result wizard:action="load_launcher_layout" />
    </WizardAction>

    <!-- Add an account -->
    <WizardAction id="load_work_account_intent" wizard:ifLifecycle="default"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.LOAD_ADD_ACCOUNT_INTENT;B.isQuickStart=true;B.showTapAndGo=false;B.is_work_profile_setup=true;B.isPropagateSsContext=false;end" />

    <WizardAction id="work_account_setup" wizard:ifLifecycle="default"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.SECOND_ACCOUNT_SETUP;B.allowMultipleAccounts=true;end">
        <result wizard:name="unintentional_cancel"
            wizard:resultCode="102"
            wizard:action="work_rollback_auth_early_update" />
        <result wizard:action="load_launcher_layout" />
    </WizardAction>

    <!-- Script that includes steps to rollback auth early update [REQUIRED] -->
    <WizardAction id="work_rollback_auth_early_update"
        wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_rollback_auth_early_update_flow">
        <result wizard:action="load_work_account_intent" />
    </WizardAction>

    <!-- Wait for launcher layout to load [RECOMMENDED] -->
    <WizardAction id="load_launcher_layout" wizard:ifLifecycle="default"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.LOAD_LAUNCHER_LAYOUT;end">
        <result wizard:action="END_OF_SCRIPT" />
    </WizardAction>

    <!-- Leave Setup Wizard (for demo mode) [REQUIRED] -->
    <WizardAction id="exit"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.EXIT;end" />

    <WizardAction id="END_OF_SCRIPT" />

</WizardScript>
