<?xml version="1.0" encoding="UTF-8"?>
<!--
    The wizard:uris recorded here have the inconvenience of being generated by hand, but they allow
    for the full spread of launch flags (we need FLAG_ACTIVITY_NEW_TASK [0x10000000]), where the
    <intent> tag processed by Intent.parseIntent() does not.

    adb shell am to-intent-uri -a com.android.setupwizard.WELCOME -f 0x10000000 \-\-ez firstRun true
-->
<WizardScript xmlns:wizard="http://schemas.android.com/apk/res/com.google.android.setupwizard"
    wizard:version="2">

    <!-- Checkin with Gservices using account. If it fails, VPA will not be available. [RECOMMENDED] -->
    <WizardAction id="dpm_gms_account_checkin"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.GMS_ACCOUNT_CHECKIN;end" />

    <!-- eSim/pSim setup flow [REQUIRED] -->
    <WizardAction id="dpm_quick_start_esim_transfer"
        wizard:ifFlow="quick_start_zero_touch_flow"
        wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_sim_setup_flow" />

    <!-- Set up biometric screen lock. The action must precede the payments action [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="dpm_quick_start_biometric" wizard:ifFlow="quick_start_zero_touch_flow"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.QUICK_START_BIOMETRIC;end">
        <result wizard:name="skip"
            wizard:resultCode="1"
            wizard:action="dpm_google_services" />
    </WizardAction>

    <!-- Set screen lock options. The action must precede the payments action [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="dpm_quick_start_lock_screen" wizard:ifFlow="quick_start_zero_touch_flow"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.QUICK_START_LOCK_SCREEN;end" />

    <!-- Show Google services opt-ins and Terms of Service [RECOMMENDED] -->
    <WizardAction id="dpm_google_services"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.GOOGLE_SERVICES;end">
        <result wizard:name="unintentional_cancel"
            wizard:resultCode="102"
            wizard:action="rollback_auth_early_update" />
        <result wizard:action="esim_setup_final_hold" />
    </WizardAction>

    <!-- Script that includes steps to rollback auth early update [REQUIRED] -->
    <WizardAction id="rollback_auth_early_update"
        wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_rollback_auth_early_update_flow">
        <result wizard:action="dpm_google_services" />
    </WizardAction>

    <!-- Start eSim final hold for quick start zero touch device owner flow [RECOMMENDED] -->
    <WizardAction id="esim_setup_final_hold"
        wizard:ifFlow="quick_start_zero_touch_flow"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.ESIM_SETUP;i.setup_type=5;end" />

</WizardScript>
