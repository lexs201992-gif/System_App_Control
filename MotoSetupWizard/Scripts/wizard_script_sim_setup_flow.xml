<?xml version="1.0" encoding="UTF-8"?>
<!--
    The wizard:uris recorded here have the inconvenience of being generated by hand, but they allow
    for the full spread of launch flags (we need FLAG_ACTIVITY_NEW_TASK [0x10000000]), where the
    <intent> tag processed by Intent.parseIntent() does not.

    adb shell am to-intent-uri -a com.android.setupwizard.WELCOME -f 0x10000000 \-\-ez firstRun true
-->
<WizardScript xmlns:wizard="http://schemas.android.com/apk/res/com.google.android.setupwizard"
    wizard:version="2">

    <!-- Check which existing profile should be enabled [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="sim_slots_selection"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.SLOTS_SELECTION;B.isEsimFirst=true;end">
        <result wizard:name="skip"
            wizard:resultCode="1"
            wizard:action="check_quick_start" />
        <result wizard:action="sim_carrier_setup" />
    </WizardAction>

    <!-- A quick setup experience [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="check_quick_start"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CHECK_QUICK_START;end">
        <!-- TODO(b/228790268): flip the conditions to go through quick start by default -->
        <result wizard:name="quick_start_esim_transfer"
            wizard:resultCode="101"
            wizard:action="quick_start_esim_transfer" />
        <result wizard:action="esim_setup_flow" />
    </WizardAction>

    <!-- Start eSim setup for quick start flow [RECOMMENDED] -->
    <WizardAction id="quick_start_esim_transfer"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.QUICK_START_ESIM_SETUP;end">
        <result wizard:action="sim_carrier_setup" />
    </WizardAction>

    <!-- Start eSim setup for non quick start flow [RECOMMENDED] -->
    <WizardAction id="esim_setup_flow"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.ESIM_SETUP;i.setup_type=2;end" />

    <!-- Activate carrier services [RECOMMENDED] -->
    <WizardAction id="sim_carrier_setup"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CARRIER_SETUP;B.isEsimFirst=true;end">
        <result wizard:name="all_subscriptions_completed"
            wizard:resultCode="98765"
            wizard:action="sim_setup" />
        <result wizard:name="skip"
            wizard:resultCode="1"
            wizard:action="sim_setup" />

        <!-- Return to carrier_setup to check for other subscriptions for multi-SIM -->
        <result wizard:action="sim_carrier_setup" />
    </WizardAction>

    <!-- On multi-SIM devices, choose which SIM to use for voice, data, and text [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="sim_setup"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.SIM_SETUP;B.isEsimFirst=true;end" />

</WizardScript>
