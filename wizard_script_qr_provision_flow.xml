<?xml version="1.0" encoding="UTF-8"?>
<!--
    The wizard:uris recorded here have the inconvenience of being generated by hand, but they allow
    for the full spread of launch flags (we need FLAG_ACTIVITY_NEW_TASK [0x10000000]), where the
    <intent> tag processed by Intent.parseIntent() does not.

    adb shell am to-intent-uri -a com.android.setupwizard.WELCOME -f 0x10000000 \-\-ez firstRun true
-->
<WizardScript xmlns:wizard="http://schemas.android.com/apk/res/com.google.android.setupwizard"
    wizard:version="2">

    <!-- Factory Reset Protection (FRP) -->
    <WizardAction id="check_frp"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.CHECK_FRP;end">
        <result wizard:name="resolve_frp"
            wizard:resultCode="101"
            wizard:action="network_settings" />
        <result wizard:action="qr_code_scan" />
    </WizardAction>

    <!-- Network -->
    <WizardAction id="network_settings"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.NETWORK_SETTINGS;end">
        <result wizard:name="use_mobile"
            wizard:resultCode="101"
            wizard:action="activate_mobile_data" />
        <result wizard:name="see_all_wifi"
            wizard:resultCode="102"
            wizard:action="wifi_settings" />
        <result wizard:action="captive_portal" />
    </WizardAction>

    <!-- Activate mobile network -->
    <WizardAction id="activate_mobile_data"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.ACTIVATE_MOBILE_DATA;end">
        <result wizard:action="captive_portal" />
    </WizardAction>

    <!-- Wi-Fi setup -->
    <WizardAction id="wifi_settings"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.WIFI_SETTINGS;end">
        <result wizard:name="use_mobile"
            wizard:resultCode="101"
            wizard:action="activate_mobile_data" />
    </WizardAction>

    <!-- Resolve captive portal access, and wait for check-in -->
    <WizardAction id="captive_portal"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CAPTIVE_PORTAL;end" />

    <WizardAction id="gms_checkin"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.GMS_CHECKIN;end">
        <result wizard:name="timeout"
            wizard:resultCode="101"
            wizard:action="network_timeout" />
        <result wizard:action="load_account_intent_frp" />
    </WizardAction>

    <!-- Network or check-in timeout [REQUIRED] -->
    <WizardAction id="network_timeout"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.NETWORK_TIMEOUT;B.isSkipAllowed=false;end" />

    <!-- Resolve the FRP challenge, this action is not part of quick start flow. Thus, we don't pass isQuickStart extra here. -->
    <WizardAction id="load_account_intent_frp"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.LOAD_ADD_ACCOUNT_INTENT;B.showTapAndGo=false;B.resolveFrpOnly=true;end" />

    <WizardAction id="resolve_frp"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.ACCOUNT_SETUP;B.finishWhenDone=true;end">
        <result wizard:name="unintentional_cancel"
            wizard:resultCode="102"
            wizard:action="rollback_auth_early_update" />
        <result wizard:action="qr_code_scan" />
    </WizardAction>

    <!-- Script that includes steps to rollback auth early update [REQUIRED] -->
    <WizardAction id="rollback_auth_early_update"
        wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_rollback_auth_early_update_flow">
        <result wizard:action="load_account_intent_frp" />
    </WizardAction>

    <!-- Scan QR code for device owner provisioning -->
    <WizardAction id="qr_code_scan"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.QR_CODE_SCAN;end">
        <!-- The restore flow would be set to cloud for COPE devices if the result code returned the adding personal account. -->
        <result wizard:name="add_personal_account_after_work_profile"
            wizard:resultCode="120"
            wizard:action="qr_gms_checkin_pre_add_account" />
        <result wizard:name="work_profile_setup"
            wizard:resultCode="122"
            wizard:action="work_profile_setup" />
        <result wizard:name="device_owner_setup"
            wizard:resultCode="123"
            wizard:action="device_owner_setup" />
        <result wizard:name="provisioning_extras_saved"
            wizard:resultCode="127"
            wizard:action="establish_network_connection" />
        <result wizard:name="provisioning_extras_not_saved"
            wizard:resultCode="128"
            wizard:action="fail_provisioning" />
        <result wizard:action="qr_gms_checkin" />
    </WizardAction>

    <!-- Establish network connection prior to QR provisioning -->
    <WizardAction id="establish_network_connection"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.START_ESTABLISH_NETWORK_CONNECTION;end">
        <result wizard:name="network_connection_not_established"
            wizard:resultCode="126"
            wizard:action="offline_provisioning_check" />
        <result wizard:name="skip"
            wizard:resultCode="1"
            wizard:action="start_provisioning_flow"/>
    </WizardAction>

    <!--
        Resolve captive portal access, and wait for check-in [REQUIRED]
        What this action do is same with "com.android.setupwizard.CAPTIVE_PORTAL".
        The intent action on only used when the captive portal in front of GMS check-in.
        We separate this intent action in order to have better user experience.
    -->
    <WizardAction id="consolidate_captive_portal"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CONSOLIDATE_CAPTIVE_PORTAL;end">
        <result wizard:name="timeout"
            wizard:resultCode="101"
            wizard:action="offline_provisioning_check" />
    </WizardAction>

    <!-- After network connects, check whether date, time, and time zone is updated by automated services [RECOMMENDED] -->
    <WizardAction id="date_time_check"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.DATE_TIME_CHECK;end" />

    <!-- Gms check-in and update flow. [REQUIRED] -->
    <WizardAction id="pre_checkin_and_update_after_network_connection_established"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.PRE_CHECKIN_AND_UPDATE;end">
        <!-- The QR provision doesn't support the OTA case, so skip it then do the early update directly to avoid exceptions -->
        <result wizard:name="ota_available"
            wizard:resultCode="102"
            wizard:action="early_update" />
        <result wizard:action="post_checkin_and_update_after_network_connection_established" />
    </WizardAction>

    <!-- If OTA available then make system to complete the early update process [REQUIRED] -->
    <WizardAction id="early_update" wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.COMPAT_EARLY_UPDATE;end" />

    <!-- Gms check-in and update flow. all action between pre_checkin_and_update and
          post_checkin_and_update are required and not allow to change. [REQUIRED] -->
    <WizardAction id="post_checkin_and_update_after_network_connection_established"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.POST_CHECKIN_AND_UPDATE;end">
        <result wizard:action="start_provisioning_flow" />
    </WizardAction>

    <WizardAction id="offline_provisioning_check"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.OFFLINE_PROVISIONING_CHECK;end">
        <result
            wizard:name="offline_provisioning_disallowed"
            wizard:resultCode="1"
            wizard:action="fail_provisioning" />
        <result
            wizard:name="offline_provisioning_allowed"
            wizard:action="start_provisioning_flow" />
    </WizardAction>

    <WizardAction id="start_provisioning_flow"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.START_PROVISIONING;end">
        <result wizard:name="add_personal_account_after_work_profile"
            wizard:resultCode="120"
            wizard:action="qr_gms_checkin_pre_add_account" />
        <result wizard:name="work_profile_setup"
            wizard:resultCode="122"
            wizard:action="work_profile_setup" />
        <result wizard:name="device_owner_setup"
            wizard:resultCode="123"
            wizard:action="device_owner_setup" />
        <result wizard:name="failed_to_start_provisioning"
            wizard:resultCode="129"
            wizard:action="fail_provisioning" />
        <result wizard:action="qr_gms_checkin" />
    </WizardAction>

    <WizardAction id="work_profile_setup"
        wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_post_dpm_provision_finalization_flow">
        <result wizard:action="transition_to_personal_profile_setup" />
    </WizardAction>

    <WizardAction id="device_owner_setup"
        wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_post_dpm_provision_finalization_flow">
        <result wizard:action="qr_gms_checkin" />
    </WizardAction>

    <WizardAction id="transition_to_personal_profile_setup"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.TRANSITION_TO_PERSONAL_PROFILE_SETUP;end">
        <result wizard:name="add_personal_account"
            wizard:resultCode="-1"
            wizard:action="qr_gms_checkin_pre_add_account" />
        <result wizard:name="skip_add_personal_account"
            wizard:resultCode="1"
            wizard:action="no_account_flow" />
    </WizardAction>

    <WizardAction id="qr_gms_checkin_pre_add_account"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.GMS_CHECKIN;end" />

    <!-- A quick setup experience [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="check_quick_start"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CHECK_QUICK_START;B.isPropagateSsContext=false;end">
        <!-- TODO(b/228790268): flip the conditions to go through quick start by default -->
        <result wizard:name="quick_start"
            wizard:resultCode="101"
            wizard:action="quick_start_account_flow" />
        <result wizard:action="add_personal_account_after_work_profile" />
    </WizardAction>

    <WizardAction id="quick_start_account_flow"
        wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_quick_start_transfer_account_flow" />

    <!-- Restore data from source device or cloud [REQUIRED] -->
    <WizardAction id="quick_start_restore_flow"
        wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_quick_start_restore_flow">
        <result wizard:action="END_OF_SCRIPT" />
    </WizardAction>

    <WizardAction id="add_personal_account_after_work_profile"
        wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_account_flow">
        <result wizard:action="END_OF_SCRIPT" />
    </WizardAction>

    <!-- Set up without an account [REQUIRED] -->
    <WizardAction id="no_account_flow"
        wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_no_account_flow">
        <result wizard:action="END_OF_SCRIPT" />
    </WizardAction>

    <!-- Device is restarted in this step -->
    <WizardAction id="fail_provisioning"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.SHOW_PROVISIONING_ERROR;end" />

    <WizardAction id="qr_gms_checkin"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.GMS_CHECKIN;end" />

    <!-- Flow to run after a user-led device policy managed setup. [RECOMMENDED] -->
    <WizardAction id="post_dpm_user_flow"
        wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_post_dpm_user_flow" />

    <WizardAction id="END_OF_SCRIPT" />
</WizardScript>
